# Sistema operacional
.DS_Store
Thumbs.db

# Segredos e ambiente local: nunca versionar
.env
.env.*
!.env.example
application-local.yml
application-local.properties

# Saida das ferramentas de seguranca. Os relatorios sao anexados ao documento
# de entrega em PDF, nao versionados.
dependency-check-report.*
zap-report.*
